# Storage Configuration
STORAGE_MODE=database
FILE_STORAGE_DIR=./data
FILE_STORAGE_PATH=./data/app-data.json
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=admin123
DEMO_ADMIN_NAME=System Administrator

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/bob_catalog
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-256-bits
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-256-bits
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=development
PORT=3000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# CSRF Configuration
CSRF_SECRET=your-csrf-secret-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Cookie Configuration
COOKIE_SECRET=your-cookie-secret-key-change-this-in-production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Logging
LOG_LEVEL=info
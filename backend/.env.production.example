# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.production and update with your production values
# NEVER commit .env.production to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection settings
DB_HOST=your-production-db-host.com
DB_PORT=5432
DB_NAME=bob_demo_catalog
DB_USER=bob_app_user
DB_PASSWORD=your-secure-database-password-here

# Database connection pool settings (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# Enable SSL for database connection (recommended for production)
DB_SSL=true

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Set to your production frontend URL
CORS_ORIGIN=https://your-production-domain.com

# Multiple origins (comma-separated)
# CORS_ORIGIN=https://domain1.com,https://domain2.com

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Password hashing rounds (10-12 recommended for production)
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session configuration
SESSION_SECRET=your-session-secret-key-here

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable detailed error logging
DETAILED_ERRORS=false

# -----------------------------------------------------------------------------
# Email Configuration (if applicable)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-email@domain.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=noreply@your-domain.com

# -----------------------------------------------------------------------------
# File Upload Configuration (if applicable)
# -----------------------------------------------------------------------------
# MAX_FILE_SIZE=10485760
# UPLOAD_DIR=/var/uploads

# -----------------------------------------------------------------------------
# External Services (if applicable)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://your-redis-host:6379
# S3_BUCKET=your-s3-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# -----------------------------------------------------------------------------
# Monitoring & Analytics (if applicable)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-new-relic-key
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# -----------------------------------------------------------------------------
# Feature Flags (if applicable)
# -----------------------------------------------------------------------------
# ENABLE_REGISTRATION=false
# ENABLE_API_DOCS=false
# MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# SSL/TLS Configuration
# -----------------------------------------------------------------------------
# SSL_KEY_PATH=/path/to/ssl/key.pem
# SSL_CERT_PATH=/path/to/ssl/cert.pem

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Generate strong, unique secrets for JWT_SECRET and SESSION_SECRET
# 2. Use environment-specific database credentials
# 3. Enable SSL for database connections
# 4. Set CORS_ORIGIN to your exact production domain
# 5. Never use default or example passwords
# 6. Regularly rotate secrets and credentials
# 7. Use a secrets management service (AWS Secrets Manager, HashiCorp Vault)
# 8. Enable monitoring and alerting
# 9. Regular security audits and updates
# 10. Implement proper backup and disaster recovery procedures
# =============================================================================
# =============================================================================
# FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains production environment variables for the frontend
# Update VITE_API_URL to point to your production backend API
# =============================================================================

# Backend API URL
# Update this to your production backend URL
VITE_API_URL=https://api.your-production-domain.com/api

# =============================================================================
# NOTES
# =============================================================================
# - The VITE_ prefix is required for Vite to expose variables to the client
# - Do not include trailing slashes in the API URL
# - Ensure the backend URL is accessible from the client browser
# - For local production testing, use: http://localhost:3000/api
# - For Docker deployment, use the backend service URL
# - For cloud deployment, use your cloud backend URL
# =============================================================================